# Local development (backend running on the host, Postgres in docker-compose)
GREENLIGHT_DATABASE_URL=postgresql+psycopg://greenlight:greenlight@localhost:5433/greenlight

# Applicant notices. Without a mail server they are recorded and shown in the portal, but not delivered.
GREENLIGHT_PORTAL_BASE_URL=http://localhost:3100
